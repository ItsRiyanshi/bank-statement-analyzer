# Database Connection:
# Local development (SQLite fallback):
DATABASE_URL=sqlite:///./bank_analyzer.db
# Production (Neon / Supabase / Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/neondb?sslmode=require

# CORS Configuration:
# Comma-separated list of allowed web origins (e.g., your Hugging Face Space URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex to match Hugging Face subdomains (defaults to r"^https:\/\/.*\.hf\.space$")
# CORS_ORIGIN_REGEX=^https:\/\/.*\.hf\.space$

UPLOAD_DIR=./uploads

# Google Calendar API (free) - https://console.cloud.google.com/
# Create OAuth 2.0 credentials (Desktop app), download as credentials.json
# and place it in backend/ (do NOT commit it).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
